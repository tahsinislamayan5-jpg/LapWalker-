<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#00E5FF"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tv_exercise_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_pillar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_form_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FORM GUIDE"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btn_toggle_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="HIDE"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layout_guide_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E2E8F0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_form_cues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_set_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_benchmark_rule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#94A3B8"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp">

        <!-- REPS CONTAINER -->
        <LinearLayout
            android:id="@+id/layout_reps_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_rep_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#00E5FF"
                android:textSize="72sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_increment_rep"
                android:layout_width="200dp"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#00E5FF"
                android:text="+1 REP"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_complete_set"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#1E293B"
                android:text="COMPLETE SET"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- TIMER CONTAINER -->
        <LinearLayout
            android:id="@+id/layout_timer_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress_hold"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:progressDrawable="@drawable/step_progress_ring" />

            <TextView
                android:id="@+id/tv_hold_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-130dp"
                android:text="00"
                android:textColor="#00E5FF"
                android:textSize="48sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_start_hold"
                android:layout_width="200dp"
                android:layout_height="64dp"
                android:layout_marginTop="90dp"
                android:backgroundTint="#00E5FF"
                android:text="START HOLD"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- REST OVERLAY -->
    <LinearLayout
        android:id="@+id/layout_rest_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:gravity="center"
        android:orientation="vertical"
        android:translationZ="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REST"
            android:textColor="#00E5FF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_rest_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_skip_rest"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#1E293B"
            android:text="SKIP REST"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- RESULT OVERLAY -->
    <LinearLayout
        android:id="@+id/layout_result_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:gravity="center"
        android:orientation="vertical"
        android:translationZ="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00E5FF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_result_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#E2E8F0"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_finish_continue"
            android:layout_width="200dp"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#00E5FF"
            android:text="CONTINUE"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
