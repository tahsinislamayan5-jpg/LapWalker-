<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tv_badge_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="🎖️"
        android:textSize="20sp"
        android:background="@drawable/theme_chip_bg_light" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_badge_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="True Mile"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_badge_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Walk >= 1.609 km in a single session"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_badge_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UNLOCKED"
        android:textColor="#10B981"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
